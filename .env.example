# FestFlow Environment Configuration Template
# Copy this file to .env and populate with your own credentials

# Supabase Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=fest-passes

# Payment Gateway / UPI details
UPI_VPA=festorganizer@upi
UPI_PAYEE_NAME="Fest Organizing Committee"

# Security (HMAC dynamic QR verification)
PASS_SIGNING_SECRET=generate-a-secure-random-64-character-hex-string

# Anti-Fraud Visual Forensics (Optional - fallback OCR used if unconfigured)
GEMINI_API_KEY=

# Institution Configuration
HOST_COLLEGE_NAME="Host Engineering College"
ADMIN_PHONE="910000000000"
ADMIN_NUMBERS="910000000000"

# Group Distribution Strategy (individual | shared)
GROUP_DISTRIBUTION_STRATEGY=individual

# WhatsApp Bot Pairing Phone (optional if linking via phone number)
BOT_PHONE_NUMBER=

# Baileys Multi-Auth Session Directory
AUTH_FOLDER=./auth_info_baileys
